{
  "name": "gama-remote",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Gama Remote: acesso Windows pelo navegador, baseado em MeshCentral",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "postinstall": "node scripts/patch-engine.js",
    "setup": "node scripts/setup.js",
    "admin": "node scripts/admin.js",
    "start": "node server.js",
    "doctor": "node scripts/doctor.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "audit:security": "npm audit --omit=dev --audit-level=moderate",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "acme-client": "4.2.5",
    "https-proxy-agent": "7.0.6",
    "meshcentral": "1.2.5"
  },
  "overrides": {
    "compression": "1.8.2",
    "qs": "6.16.0",
    "axios": "1.20.0"
  }
}
